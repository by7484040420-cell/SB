# Postgres connection string. Free option: create a project at
# https://neon.tech (or Supabase/Vercel Postgres/Railway) and paste its
# connection string here. Tables + indexes are created automatically on
# first request — no manual migration step needed.
DATABASE_URL=

# Comma-separated mobile numbers that get admin access (e.g. "9876543210,9123456789")
ADMIN_MOBILE_NUMBERS=

# Gemini API key for AI-powered job scanning — get one free at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret shared between this app and your cron scheduler, so only your
# scheduler can trigger /api/cron/scan-jobs. Make up any long random string.
CRON_SECRET=

# SMS provider (MSG91 by default) — set this to send real OTPs. Without
# it, OTPs still show directly in the login UI (dev mode only — never do
# this in production, anyone could log in as anyone).
# Get a key at https://msg91.com (or swap the provider in send-otp/route.js)
SMS_API_KEY=
# Optional: MSG91 DLT-approved template ID for the OTP SMS
SMS_TEMPLATE_ID=

# Your live site URL (no trailing slash) — used for sitemap.xml, robots.txt,
# and social-share preview links. e.g. https://sarkari-ai.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: URL of a separately-deployed Playwright browser server for the
# "AI fills the form for you" feature. Leave blank to disable that feature.
# SECURITY: no NEXT_PUBLIC_ prefix on purpose — this must stay server-only.
# The app calls it via a server-side proxy (app/api/remote-browser), never
# directly from the browser, so this URL is never sent to the client.
REMOTE_BROWSER_URL=

# Shared secret between this app and the remote browser server above — set
# the SAME long random value on both. Without this, the remote browser
# server would accept requests from anyone who found its URL. Generate one
# with: openssl rand -hex 32
REMOTE_BROWSER_SECRET=

# --- Notifications (WhatsApp + Email job alerts) ---
# Redis, for the background notification queue (BullMQ). Free tier works
# fine: https://upstash.com (pick the "Redis" product, use the TCP URL)
REDIS_URL=

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp
# You also need an approved message template named "new_job_alert" (or set
# WHATSAPP_TEMPLATE_NAME) in Meta Business Manager before this works.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=new_job_alert

# Optional but recommended for SPEED: name of an approved WhatsApp
# "Authentication" category template (separate from WHATSAPP_TEMPLATE_NAME
# above) used to deliver login OTPs. WhatsApp auth-template delivery skips
# India's SMS/DLT telecom pipeline entirely, so it arrives near-instantly —
# this is how apps like Hotstar get 1-2 second OTP delivery instead of the
# 30s-2min you can get from plain promotional-route SMS. Create it in Meta
# Business Manager → WhatsApp → Message Templates → category
# "Authentication" (WhatsApp writes the message body for you). Leave blank
# to skip WhatsApp and use SMS_API_KEY below instead.
WHATSAPP_OTP_TEMPLATE_NAME=

# Resend — https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com

# --- Payments (Razorpay) ---
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
